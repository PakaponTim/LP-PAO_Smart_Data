# Water_System2 — Apache Security Hardening for Subdomain / Folder Hosting
Options -Indexes

# Block direct HTTP access to hidden files (.env, .git, etc.) and sensitive configs/logs
<FilesMatch "(^\.|\.(log(\.[0-9]+)?|sql|sqlite|bak|flag)$|^(config|task_history|package|package-lock|tsconfig)\.json$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(runtime|php_server|cloud_snapshots|tests|archive_scratch|scripts|\.git|\.github|\.work-backups)(/|$) - [F,L,NC]
</IfModule>
