{
  "manifest_version": 3,
  "name": "Traffy Fondue Scraper for Lampang",
  "version": "1.0",
  "description": "Chrome Extension สำหรับดึงข้อมูลเรื่องร้องเรียนจังหวัดลำปางจาก Traffy Fondue เข้าสู่ฐานข้อมูลระบบบริหารจัดการน้ำโดยตรง",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://citydata.traffy.in.th/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://citydata.traffy.in.th/*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "socket.io.min.js",
        "auth.js",
        "content.js"
      ]
    }
  ],
  "options_page": "options.html",
  "optional_host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*/*"
  ]
}